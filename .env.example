# Провайдер LLM: auto (MiMo основной, Gemini запасной), gemini или mimo
LLM_PROVIDER=auto

GEMINI_API_KEY=your_key_here
GEMINI_MODEL=gemini-3.8-flash

# Xiaomi MiMo (OpenAI-совместимый API). Оставьте пустым, если не используете
MIMO_API_KEY=
MIMO_BASE_URL=https://api.xiaomimimo.com/v1
MIMO_MODEL=mimo-v2.6-flash

LLM_TIMEOUT_S=90
LLM_ATTEMPTS=2
MAX_PDF_SIZE_MB=10
MAX_RESUME_CHARS=20000
MAX_JOB_CHARS=15000
URL_FETCH_TIMEOUT_S=10
APP_ENV=development
