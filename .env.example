# Провайдер LLM: auto (цепочка YandexGPT, Gemini, GigaChat; используются только те, у кого задан ключ),
# либо yandex, gemini или gigachat. DeepSeek доступен на сайте по выбору, если задан ключ Яндекса
LLM_PROVIDER=auto

GEMINI_API_KEY=your_key_here
GEMINI_MODEL=gemini-3.8-flash

# YandexGPT (Yandex AI Studio): API-ключ и идентификатор каталога
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
YANDEX_MODEL=yandexgpt-5.1/latest
DEEPSEEK_MODEL=deepseek-v4.1-flash/latest

# GigaChat (Сбер): ключ авторизации из личного кабинета developers.sber.ru
GIGACHAT_AUTH_KEY=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat-2-Max
GIGACHAT_CA_BUNDLE=certs/russian_trusted_root_ca.pem

LLM_TIMEOUT_S=90
LLM_ATTEMPTS=2
MAX_PDF_SIZE_MB=10
MAX_RESUME_CHARS=20000
MAX_JOB_CHARS=15000
URL_FETCH_TIMEOUT_S=10
APP_ENV=development
