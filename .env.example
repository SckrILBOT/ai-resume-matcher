# Провайдер LLM: auto (по очереди MiMo, Gemini, GigaChat; используются только те, у кого задан ключ),
# либо gemini, mimo или gigachat
LLM_PROVIDER=auto

GEMINI_API_KEY=your_key_here
GEMINI_MODEL=gemini-3.8-flash

# Xiaomi MiMo (OpenAI-совместимый API). Оставьте пустым, если не используете
MIMO_API_KEY=
MIMO_BASE_URL=https://api.xiaomimimo.com/v1
MIMO_MODEL=mimo-v2.6-flash

# GigaChat (Сбер): ключ авторизации из личного кабинета developers.sber.ru
GIGACHAT_AUTH_KEY=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat-2
GIGACHAT_CA_BUNDLE=certs/russian_trusted_root_ca.pem

LLM_TIMEOUT_S=90
LLM_ATTEMPTS=2
MAX_PDF_SIZE_MB=10
MAX_RESUME_CHARS=20000
MAX_JOB_CHARS=15000
URL_FETCH_TIMEOUT_S=10
APP_ENV=development
